{
    "name": "danjamesmills/laravel-dropzonejs",
    "description": "A comprehensive Laravel package for effortless file management with Dropzone.js.",
    "keywords": [
        "laravel",
        "dropzone",
        "file upload",
        "file management",
        "package"
    ],
    "homepage": "https://github.com/danjamesmills/laravel-dropzonejs",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Daniel Mills",
            "email": "daniel620@hotmail.co.uk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3",
        "danjamesmills/laravel-response": "^1.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "orchestra/testbench": "^6.23|^7.0"
    },
    "autoload": {
        "psr-4": {
            "DanJamesMills\\LaravelDropzone\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DanJamesMills\\LaravelDropzone\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "DanJamesMills\\LaravelDropzone\\LaravelDropzoneServiceProvider"
            ],
            "aliases": {
                "LaravelDropzonejs": "DanJamesMills\\LaravelDropzone\\LaravelDropzoneFacade"
            }
        }
    }
}
